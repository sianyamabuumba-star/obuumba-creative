:root {
  --bg: #0A0A0F;
  --bg-2: #101018;
  --card: #14141D;
  --card-2: #1A1A26;
  --purple: #6D28D9;
  --purple-deep: #3B1470;
  --purple-glow: #8B5CF6;
  --gold: #D4AF37;
  --gold-soft: #F0D98A;
  --gold-deep: #8A6D1B;
  --ivory: #FFF8ED;
  --muted: #CFC6B4;
  --dim: #9B937F;
  --line: rgba(255, 255, 255, 0.08);
  --shadow: 0 30px 60px rgba(0, 0, 0, 0.26);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at top left, rgba(109, 40, 217, 0.15), transparent 20%),
    linear-gradient(180deg, var(--bg) 0%, #0d0d14 100%);
  color: var(--ivory);
  font-family: Inter, system-ui, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
  display: block;
}

.page-shell {
  max-width: 1180px;
  margin: 0 auto;
  padding: 20px 20px 80px;
}

.topbar {
  position: sticky;
  top: 16px;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 16px 22px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(16, 16, 24, 0.72);
  backdrop-filter: blur(12px);
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--purple-glow), var(--gold-soft));
  color: var(--bg);
  font-weight: 800;
}

.nav {
  display: flex;
  align-items: center;
  gap: 18px;
  color: var(--muted);
  font-size: 0.92rem;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 18px;
  border-radius: 999px;
  border: 1px solid transparent;
  font-weight: 700;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.button:hover {
  transform: translateY(-1px);
}

.button-primary {
  background: linear-gradient(135deg, var(--purple-glow), var(--gold-soft));
  color: var(--bg);
  box-shadow: var(--shadow);
}

.button-ghost {
  border-color: var(--line);
  background: rgba(255, 255, 255, 0.02);
}

.hero {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 30px;
  align-items: center;
  padding: 70px 0 34px;
}

.eyebrow {
  display: inline-block;
  color: var(--gold-soft);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-size: 0.72rem;
  font-weight: 700;
}

.hero h1 {
  margin: 16px 0 18px;
  font-size: clamp(3rem, 6vw, 5.5rem);
  line-height: 0.95;
  letter-spacing: -0.07em;
}

.lead,
.description {
  max-width: 620px;
  color: var(--muted);
  font-size: 1.06rem;
  line-height: 1.8;
}

.description {
  margin-top: 10px;
}

.cta-row,
.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 24px;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 30px;
}

.metrics div {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 18px 16px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.02);
}

.metrics strong {
  font-size: 1.3rem;
}

.metrics span {
  color: var(--muted);
  font-size: 0.8rem;
}

.hero-card-wrap {
  display: flex;
  justify-content: center;
}

.hero-card {
  width: min(100%, 440px);
  padding: 20px;
  border-radius: 32px;
  border: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(20, 20, 29, 0.94), rgba(10, 10, 15, 0.96));
  box-shadow: var(--shadow);
}

.card-topline,
.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.status,
.online-pill,
.chip,
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 0.74rem;
  font-weight: 700;
}

.status {
  padding: 8px 10px;
  background: rgba(255, 255, 255, 0.05);
  color: var(--ivory);
}

.online-pill {
  padding: 7px 10px;
  background: rgba(139, 92, 246, 0.18);
  color: var(--gold-soft);
}

.visual-grid {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 12px;
  margin: 22px 0;
}

.block {
  min-height: 140px;
  border-radius: 18px;
  border: 1px solid var(--line);
  background: linear-gradient(135deg, rgba(109, 40, 217, 0.38), rgba(255, 255, 255, 0.05));
}

.block.one {
  min-height: 220px;
}

.block.two,
.block.three,
.block.four {
  min-height: 100px;
}

.card-bottom {
  align-items: flex-start;
  padding-top: 8px;
}

.card-bottom small {
  display: block;
  color: var(--muted);
  margin-bottom: 6px;
  font-size: 0.7rem;
}

.card-bottom strong {
  display: block;
  font-size: 0.92rem;
}

.section {
  padding-top: 54px;
}

.section-title {
  margin-bottom: 24px;
}

.section-title h2 {
  margin: 10px 0 0;
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.06em;
}

.service-grid,
.work-grid,
.pricing-grid,
.testimonial-grid,
.process-grid {
  display: grid;
  gap: 20px;
}

.service-grid,
.work-grid,
.pricing-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.process-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.testimonial-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.info-card,
.work-card,
.price-card,
.process-card,
.quote-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 22px;
}

.info-card h3,
.work-card h3,
.price-card h3 {
  margin: 18px 0 12px;
  font-size: 1.5rem;
}

.info-card p,
.work-card p,
.process-card p,
.quote-card p,
.price-card p {
  color: var(--muted);
  line-height: 1.7;
}

.chip,
.tag {
  padding: 8px 12px;
  background: rgba(139, 92, 246, 0.12);
  color: var(--gold-soft);
}

.mini-visual {
  min-height: 180px;
  border-radius: 16px;
  border: 1px solid var(--line);
  background: linear-gradient(135deg, rgba(109, 40, 217, 0.24), rgba(212, 175, 55, 0.12));
}

.tag {
  margin: 16px 0 10px;
}

.step-number {
  display: inline-flex;
  margin-bottom: 14px;
  color: var(--gold-soft);
  font-weight: 800;
}

.price-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 240px;
}

.price-card.featured {
  border-color: rgba(212, 175, 55, 0.35);
  background: linear-gradient(180deg, rgba(212, 175, 55, 0.08), rgba(255, 255, 255, 0.02));
}

.price-card small {
  color: var(--muted);
  margin-top: 18px;
}

.pricing-disclaimer {
  margin-top: 22px;
  color: var(--muted);
  line-height: 1.7;
}

.quote-card {
  margin: 0;
}

.quote-card footer {
  margin-top: 16px;
  color: var(--gold-soft);
  font-weight: 700;
}

.cta-panel {
  margin-top: 56px;
  padding: 32px 28px;
  border-radius: 30px;
  border: 1px solid var(--line);
  background: linear-gradient(135deg, rgba(109, 40, 217, 0.15), rgba(13, 13, 20, 0.8));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.cta-panel h2 {
  margin: 10px 0 0;
  max-width: 760px;
  font-size: clamp(1.6rem, 3vw, 2.8rem);
  letter-spacing: -0.05em;
}

@media (max-width: 920px) {
  .topbar {
    border-radius: 24px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav {
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero,
  .service-grid,
  .work-grid,
  .pricing-grid,
  .testimonial-grid,
  .process-grid,
  .cta-panel {
    grid-template-columns: 1fr;
    display: grid;
  }

  .cta-panel {
    justify-content: stretch;
  }
}

@media (max-width: 560px) {
  .page-shell {
    padding-left: 14px;
    padding-right: 14px;
  }

  .metrics {
    grid-template-columns: 1fr;
  }

  .nav {
    gap: 10px;
    font-size: 0.82rem;
  }
}
